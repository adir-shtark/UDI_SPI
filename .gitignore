# 1. Ignore all files by default
*

# 2. Allow Git to traverse all directories (CRITICAL for whitelist approach)
!*/

# 3. Keep the .gitignore file itself
!/.gitignore

!/*.xsa

# 4. Keep TCL scripts (Project build script, design_1.tcl)
!/*.tcl

# 5. Keep the RTL folder and all its contents
!/rtl/**

# 6. Keep the Constraints folder and all its contents
!/constraints/**

# 7. Keep Block Design files
!/bd/**/*.bd

# 8. Keep your specific C file
!/sw/hello_world_5/src/helloworld.c